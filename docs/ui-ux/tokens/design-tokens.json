{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "My Desktop App UI Design Tokens",
    "status": "APPROVED",
    "visualDirection": "L-quiet-instrument",
    "directionAcceptedOn": "2026-11-20",
    "tokenBaselineApproved": true,
    "tokenBaselineApprovedOn": "2026-11-20",
    "theme": "light-only",
    "mapping": "Generated CSS custom properties from this file by scripts/ui-ux/generate-design-tokens.mjs. Do not hand-edit the generated runtime stylesheet.",
    "note": "Token baseline approved by the user on 2026-11-20. Approval does not authorize application code or high-fidelity pages.",
    "tokenSourceOfTruth": "docs/ui-ux/tokens/design-tokens.json"
  },
  "primitive": {
    "color": {
      "neutral-0": {
        "$type": "color",
        "$value": "#F4F5F6",
        "$description": "Window field."
      },
      "neutral-0-strong": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$description": "Field and selected-row contrast surface."
      },
      "neutral-200": {
        "$type": "color",
        "$value": "#D0D5DB",
        "$description": "Hairline between regions and rows. Not the input edge."
      },
      "neutral-500": {
        "$type": "color",
        "$value": "#6B7280",
        "$description": "Input border. About 4.8:1 on white and about 4.4:1 on the canvas. Added 2026-11-20 so the field edge meets 3:1. Not a status hue."
      },
      "neutral-700": {
        "$type": "color",
        "$value": "#3E4651",
        "$description": "Secondary text."
      },
      "neutral-800": {
        "$type": "color",
        "$value": "#4A5160",
        "$description": "Meta text."
      },
      "neutral-900": {
        "$type": "color",
        "$value": "#1B1F24",
        "$description": "Primary text."
      },
      "teal-700": {
        "$type": "color",
        "$value": "#0F5F66",
        "$description": "Single accent. Not a status hue."
      },
      "teal-50": {
        "$type": "color",
        "$value": "#E6F3F3",
        "$description": "Selected-row wash behind unchanged text."
      },
      "red-800": {
        "$type": "color",
        "$value": "#8E1B1B",
        "$description": "Failure and destructive text."
      }
    },
    "font": {
      "family-sans": {
        "$type": "fontFamily",
        "$value": "ui-sans-serif, system-ui, -apple-system, Segoe UI, sans-serif",
        "$description": "Operating-system sans. No bundled webfont."
      },
      "weight-regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "weight-emphasis": {
        "$type": "fontWeight",
        "$value": 600
      },
      "size-meta": {
        "$type": "dimension",
        "$value": "12px"
      },
      "size-body": {
        "$type": "dimension",
        "$value": "13px"
      },
      "size-title": {
        "$type": "dimension",
        "$value": "16px"
      },
      "line-body": {
        "$type": "dimension",
        "$value": "18px"
      },
      "line-title": {
        "$type": "dimension",
        "$value": "20px"
      }
    },
    "space": {
      "4": {
        "$type": "dimension",
        "$value": "4px"
      },
      "8": {
        "$type": "dimension",
        "$value": "8px"
      },
      "12": {
        "$type": "dimension",
        "$value": "12px"
      },
      "16": {
        "$type": "dimension",
        "$value": "16px"
      },
      "24": {
        "$type": "dimension",
        "$value": "24px"
      },
      "32": {
        "$type": "dimension",
        "$value": "32px"
      }
    },
    "size": {
      "control": {
        "$type": "dimension",
        "$value": "32px"
      },
      "row": {
        "$type": "dimension",
        "$value": "32px"
      },
      "icon": {
        "$type": "dimension",
        "$value": "16px"
      },
      "focus": {
        "$type": "dimension",
        "$value": "2px"
      },
      "rule": {
        "$type": "dimension",
        "$value": "1px"
      },
      "window-width": {
        "$type": "dimension",
        "$value": "1200px",
        "$description": "Observed Electron window width. Not a new shell size."
      },
      "window-height": {
        "$type": "dimension",
        "$value": "800px",
        "$description": "Observed Electron window height. Not a new shell size."
      }
    },
    "radius": {
      "none": {
        "$type": "dimension",
        "$value": "0px"
      },
      "control": {
        "$type": "dimension",
        "$value": "4px"
      }
    },
    "elevation": {
      "none": {
        "$type": "shadow",
        "$value": {
          "color": "#00000000",
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "0px"
        }
      }
    },
    "motion": {
      "instant": {
        "$type": "duration",
        "$value": "0ms"
      }
    },
    "layer": {
      "base": {
        "$type": "number",
        "$value": 0
      },
      "notice": {
        "$type": "number",
        "$value": 1
      }
    }
  },
  "semantic": {
    "color": {
      "canvas": {
        "$type": "color",
        "$value": "{primitive.color.neutral-0}"
