      },
      "text-primary": {
        "$type": "color",
        "$value": "{primitive.color.neutral-900}"
      },
      "text-secondary": {
        "$type": "color",
        "$value": "{primitive.color.neutral-700}"
      },
      "text-meta": {
        "$type": "color",
        "$value": "{primitive.color.neutral-800}"
      },
      "text-on-action": {
        "$type": "color",
        "$value": "{primitive.color.neutral-0-strong}"
      },
      "text-danger": {
        "$type": "color",
        "$value": "{primitive.color.red-800}"
      },
      "border-hairline": {
        "$type": "color",
        "$value": "{primitive.color.neutral-200}"
      },
      "border-field": {
        "$type": "color",
        "$value": "{primitive.color.neutral-500}"
      },
      "action-primary": {
        "$type": "color",
        "$value": "{primitive.color.teal-700}"
      },
      "focus": {
        "$type": "color",
        "$value": "{primitive.color.teal-700}"
      },
      "selection-wash": {
        "$type": "color",
        "$value": "{primitive.color.teal-50}"
      }
    },
    "font": {
      "family": {
        "$type": "fontFamily",
        "$value": "{primitive.font.family-sans}"
      },
      "title-size": {
        "$type": "dimension",
        "$value": "{primitive.font.size-title}"
      },
      "title-line": {
        "$type": "dimension",
        "$value": "{primitive.font.line-title}"
      },
      "title-weight": {
        "$type": "fontWeight",
        "$value": "{primitive.font.weight-emphasis}"
      },
      "body-size": {
        "$type": "dimension",
        "$value": "{primitive.font.size-body}"
      },
      "body-line": {
        "$type": "dimension",
        "$value": "{primitive.font.line-body}"
      },
      "body-weight": {
        "$type": "fontWeight",
        "$value": "{primitive.font.weight-regular}"
      },
      "meta-size": {
        "$type": "dimension",
        "$value": "{primitive.font.size-meta}"
      },
      "meta-line": {
        "$type": "dimension",
        "$value": "{primitive.font.line-body}"
      },
      "meta-weight": {
        "$type": "fontWeight",
        "$value": "{primitive.font.weight-regular}"
      }
    },
    "space": {
      "inset": {
        "$type": "dimension",
        "$value": "{primitive.space.16}"
      },
      "stack": {
        "$type": "dimension",
        "$value": "{primitive.space.12}"
      },
      "inline": {
        "$type": "dimension",
        "$value": "{primitive.space.8}"
      },
      "region": {
        "$type": "dimension",
        "$value": "{primitive.space.24}"
      }
    },
    "elevation": {
      "flat": {
        "$type": "shadow",
        "$value": "{primitive.elevation.none}"
      }
    },
    "motion": {
      "feedback": {
        "$type": "duration",
        "$value": "{primitive.motion.instant}"
      }
    },
    "layer": {
      "content": {
        "$type": "number",
        "$value": "{primitive.layer.base}"
      },
      "notice": {
        "$type": "number",
        "$value": "{primitive.layer.notice}"
      }
    }
  },
  "component": {
    "button": {
      "height": {
        "$type": "dimension",
        "$value": "{primitive.size.control}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{primitive.radius.control}"
      },
      "padding-inline": {
        "$type": "dimension",
        "$value": "{primitive.space.12}"
      },
      "primary-background": {
        "$type": "color",
        "$value": "{semantic.color.action-primary}"
      },
      "primary-text": {
        "$type": "color",
        "$value": "{semantic.color.text-on-action}"
      },
      "quiet-text": {
        "$type": "color",
        "$value": "{semantic.color.text-primary}"
      },
      "danger-text": {
        "$type": "color",
        "$value": "{semantic.color.text-danger}"
      },
      "focus-width": {
        "$type": "dimension",
        "$value": "{primitive.size.focus}"
      },
      "focus-color": {
        "$type": "color",
        "$value": "{semantic.color.focus}"
      }
    },
    "field": {
      "height": {
        "$type": "dimension",
        "$value": "{primitive.size.control}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{primitive.radius.control}"
      },
      "padding-inline": {
        "$type": "dimension",
        "$value": "{primitive.space.8}"
      },
      "background": {
        "$type": "color",
        "$value": "{semantic.color.surface}"
      },
      "text": {
        "$type": "color",
        "$value": "{semantic.color.text-primary}"
      },
      "border": {
        "$type": "color",
        "$value": "{semantic.color.border-field}"
      },
      "border-width": {
        "$type": "dimension",
        "$value": "{primitive.size.rule}"
      },
      "focus-color": {
        "$type": "color",
        "$value": "{semantic.color.focus}"
      }
    },
    "row": {
      "min-height": {
        "$type": "dimension",
        "$value": "{primitive.size.row}"
      },
      "padding-inline": {
        "$type": "dimension",
        "$value": "{primitive.space.8}"
      },
      "rule": {
        "$type": "color",
        "$value": "{semantic.color.border-hairline}"
      },
      "selected-wash": {
        "$type": "color",
        "$value": "{semantic.color.selection-wash}"
      },
      "selected-mark": {
        "$type": "color",
        "$value": "{semantic.color.action-primary}"
      },
      "selected-mark-width": {
        "$type": "dimension",
        "$value": "{primitive.size.focus}"
      }
    },
    "mark": {
      "size": {
        "$type": "dimension",
        "$value": "{primitive.size.icon}"
      },
      "text": {
        "$type": "color",
        "$value": "{semantic.color.text-primary}"
      }
    },
    "notice": {
